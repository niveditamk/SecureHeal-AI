# === SecureHeal-AI Environment Configuration ===

# --- LLM Provider Keys (set at least one) ---
OPENAI_API_KEY=sk-your-openai-key-here
GOOGLE_API_KEY=your-google-api-key-here

# --- Model Selection ---
MODEL_NAME=gemini-2.0-flash

# --- Database ---
DATABASE_URL=postgresql+asyncpg://secureheal:secureheal@localhost:5432/secureheal

# --- Security Tools ---
SEMGREP_RULES=auto
ZAP_API_URL=http://localhost:8080

# --- Telemetry ---
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# --- Application ---
LOG_LEVEL=INFO
MAX_RETRIES=3
PATCH_TIMEOUT_SECONDS=300
